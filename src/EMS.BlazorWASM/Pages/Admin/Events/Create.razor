@page "/organizer/events/create"
@page "/organizer/events/new"
@page "/organizer/events/edit/{Id}"
@page "/admin/events/new"
@page "/admin/events/create"
@page "/admin/events/edit/{Id}"
@page "/SuperAdmin/Events/new"
@page "/SuperAdmin/Events/create"
@page "/SuperAdmin/Events/edit/{Id}"
@attribute [Authorize(Roles = "manager,admin,superadmin")]
@using EMS.Shared.DTOs
@using EMS.Shared.DTOs.Events
@using EMS.Shared.DTOs.Rewards
@using EMS.BlazorWASM.Services
@inject IEventServiceClient EventService
@inject IOrganizerServiceClient OrganizerService
@inject ISuperAdminServiceClient SuperAdminService
@inject IAgendaServiceClient AgendaService
@inject IRewardServiceClient RewardService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(isEditMode ? "Chỉnh sửa Sự kiện" : "Tạo Sự kiện mới") — EMS</PageTitle>

<div class="max-w-5xl mx-auto pb-12 pt-6">
    <!-- Header & Breadcrumbs -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-medium text-muted mb-2">
                <a href="/" class="hover:text-charcoal transition-colors">Bảng điều khiển</a>
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <a href="@GetParentListUrl()" class="hover:text-charcoal transition-colors">@GetParentListTitle()</a>
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <span class="text-charcoal">@(isEditMode ? "Chỉnh sửa" : "Tạo Sự kiện mới")</span>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-charcoal">@(isEditMode ? "Chỉnh sửa Sự kiện" : "Tạo Sự kiện mới")</h1>
        </div>
        <button type="button" @onclick="NavigateBack" class="px-4 py-2 text-sm font-medium text-charcoal bg-white border border-border rounded-md shadow-sm hover:bg-canvas transition-colors">
            Huỷ bỏ
        </button>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-charcoal"></div>
        </div>
    }
    else
    {
        <!-- Form -->
        <EMS.BlazorWASM.Components.EventForm 
            EventModel="@eventModel" 
            IsSubmitting="@isSubmitting" 
            ErrorMessage="@errorMessage" 
            SubmitButtonText="@(isEditMode ? "Lưu thay đổi" : "Tạo Sự Kiện Mới")" 
            IsPriceDisabled="@(isEditMode && eventStatus != 1)"
            ShowInlineAgendaAndRewards="@(!isEditMode)"
            OnValidSubmit="HandleSubmitAsync">
            
            <AdditionalButtons>
                @if (isEditMode)
                {
                    <div class="flex items-center gap-3 mt-3">
                        <button type="button" class="flex-1 py-2 px-4 border border-border rounded-md text-sm font-semibold text-charcoal bg-white hover:bg-canvas transition-colors text-center" @onclick="NavigateBack">
                            Huỷ bỏ
                        </button>
                        <button type="button" class="flex-1 py-2 px-4 border border-rose-200 rounded-md text-sm font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 transition-colors text-center" @onclick="AskDeleteEvent">
                            Xóa sự kiện
                        </button>
                    </div>
                }
            </AdditionalButtons>
        </EMS.BlazorWASM.Components.EventForm>

        @if (isEditMode && !string.IsNullOrEmpty(Id))
        {
            <!-- Standalone Agenda Editor with instant API save -->
            <div class="mt-8">
                <EMS.BlazorWASM.Components.EventAgendaEditor EventId="@Id" EventStartTime="@eventModel.StartTime" />
            </div>

            <!-- Standalone Reward Editor with instant API save -->
            <div class="mt-8">
                <EMS.BlazorWASM.Components.EventRewardEditor EventId="@Id" />
            </div>
        }
    }
</div>

<!-- Confirm Delete Modal -->
<ConfirmModal Title="Xác nhận xóa sự kiện"
              Message="@($"Bạn có chắc chắn muốn xóa sự kiện này? Hành động này không thể hoàn tác.")"
              IsOpen="isDeleteOpen"
              IsDanger="true"
              ConfirmText="Xóa sự kiện"
              CancelText="Hủy bỏ"
              OnConfirm="ConfirmDeleteEvent"
              OnCancel="() => isDeleteOpen = false" />

@code {
    [Parameter]
    public string? Id { get; set; }

    private CreateEventDto eventModel = new();
    private bool isSubmitting = false;
    private bool isLoading = true;
    private bool isDeleteOpen = false;
    private int eventStatus = 1;

    private bool isSuperAdmin = false;
    private bool isTenantAdmin = false;
    private bool isOrganizer = false;
    private string errorMessage = string.Empty;

    private bool isEditMode => !string.IsNullOrEmpty(Id);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isSuperAdmin = user.IsInRole("superadmin");
        isTenantAdmin = user.IsInRole("admin");
        isOrganizer = user.IsInRole("manager");

        if (isEditMode)
        {
            isLoading = true;
            try
            {
                var ev = await EventService.GetEventByIdAsync(Id!);
                if (ev != null)
                {
                    eventModel = new CreateEventDto
                    {
                        Title = ev.Title,
                        Description = ev.Description,
                        Location = ev.Location,
                        VenueId = ev.VenueId,
                        StartTime = ev.StartTime.ToLocalTime(),
                        EndTime = ev.EndTime.ToLocalTime(),
                        Capacity = ev.Capacity,
                        ImageUrl = ev.ImageUrl,
                        Price = ev.Price,
                        Scope = ev.Scope
                    };

                    try
                    {
                        var agendaList = await AgendaService.GetAgendaByEventAsync(Id!);
                        eventModel.AgendaItems = agendaList.Select(a => new CreateAgendaDto
                        {
                            Title = a.Title,
                            StartTime = a.StartTime.ToLocalTime(),
                            EndTime = a.EndTime.ToLocalTime()
                        }).ToList();
                    }
                    catch { }

                    try
                    {
                        var rewardList = await RewardService.GetRewardsByEventAsync(Id!, "default");
                        eventModel.Rewards = rewardList;
                    }
                    catch { }

                    eventStatus = ev.Status;
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Lỗi khi tải thông tin sự kiện: {ex.Message}";
            }
            finally
            {
                isLoading = false;
            }
        }
        else
        {
            // Default values for creation mode
            eventModel.StartTime = DateTime.Now.AddDays(1).Date.AddHours(9);
            eventModel.EndTime = DateTime.Now.AddDays(1).Date.AddHours(17);
            eventModel.Capacity = 0;
            isLoading = false;
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (eventModel.StartTime >= eventModel.EndTime)
        {
            errorMessage = "Thời gian kết thúc phải diễn ra sau thời gian bắt đầu.";
            return;
        }

        errorMessage = string.Empty;
        isSubmitting = true;
        
        try
        {
            if (isEditMode)
            {
                var updateDto = new UpdateEventDto
                {
                    Title = eventModel.Title,
                    Description = eventModel.Description,
                    Location = eventModel.Location,
                    VenueId = eventModel.VenueId,
                    StartTime = eventModel.StartTime,
                    EndTime = eventModel.EndTime,
                    Capacity = eventModel.Capacity,
                    ImageUrl = eventModel.ImageUrl,
                    Price = eventModel.Price,
                    Scope = eventModel.Scope
                };

                bool success = false;
                if (isSuperAdmin)
                {
                    success = await SuperAdminService.UpdateEventAsync(Id!, updateDto);
                }
                else
                {
                    success = await EventService.UpdateEventAsync(Id!, updateDto);
                }

                if (success)
                {
                    OrganizerService.InvalidateCache();
                    NavigateBack();
                }
                else
                {
                    errorMessage = "Có lỗi xảy ra khi cập nhật sự kiện. Vui lòng kiểm tra lại thông tin.";
                }
            }
            else
            {
                var result = await EventService.CreateEventAsync(eventModel);
                if (result != null)
                {
                    if (eventModel.Rewards != null && eventModel.Rewards.Any())
                    {
                        await RewardService.SaveEventRewardsAsync(result.Id, "default", eventModel.Rewards);
                    }

                    OrganizerService.InvalidateCache();
                    NavigateBack();
                }
                else
                {
                    errorMessage = "Có lỗi xảy ra khi tạo sự kiện. Vui lòng kiểm tra lại thông tin.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi hệ thống: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void AskDeleteEvent()
    {
        isDeleteOpen = true;
    }

    private async Task ConfirmDeleteEvent()
    {
        isDeleteOpen = false;
        isSubmitting = true;
        bool success = await EventService.DeleteEventAsync(Id!);

        if (success)
        {
            OrganizerService.InvalidateCache();
            NavigateBack();
        }
        else
        {
            errorMessage = "Xóa sự kiện thất bại. Vui lòng thử lại.";
            isSubmitting = false;
        }
    }

    private string GetParentListTitle()
    {
        if (isOrganizer) return "Sự kiện của tôi";
        return "Danh sách sự kiện";
    }

    private string GetParentListUrl()
    {
        if (isOrganizer) return "/organizer/my-events";
        if (isSuperAdmin) return "/SuperAdmin/Events";
        return "/admin/events";
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo(GetParentListUrl());
    }
}
