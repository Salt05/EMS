@page "/Admin/RewardStats"
@attribute [Authorize(Roles = "admin")]
@inject IRewardServiceClient RewardService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@using EMS.Shared.DTOs.Rewards
@using System.Text
@using System.Linq

<PageTitle>Báo cáo Thống kê Phần thưởng — EMS</PageTitle>

<div class="max-w-7xl mx-auto pb-12 pt-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-charcoal">
                Báo cáo Thống kê Phần thưởng Sinh viên
            </h1>
            <p class="text-sm text-muted mt-1">Xem chi tiết danh sách quà tặng, điểm rèn luyện và chứng nhận của sinh viên theo bộ lọc.</p>
        </div>
        <button @onclick="ExportToCsv" class="inline-flex items-center gap-2 bg-emerald-600 text-white text-sm font-semibold px-4 py-2 rounded-xl hover:bg-emerald-700 transition-colors shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Xuất file Excel (CSV)
        </button>
    </div>

    <!-- Summary Stats Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold">⭐</div>
            <div>
                <div class="text-xs text-muted font-medium">Tổng Điểm rèn luyện</div>
                <div class="text-xl font-extrabold text-indigo-600">@detailedRecords.Where(r => r.RewardType == RewardTypeDto.TrainingPoint).Sum(r => r.Amount) điểm</div>
            </div>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">🎁</div>
            <div>
                <div class="text-xs text-muted font-medium">Quà & Voucher đã phát</div>
                <div class="text-xl font-extrabold text-amber-600">@detailedRecords.Count(r => r.RewardType == RewardTypeDto.PhysicalGift || r.RewardType == RewardTypeDto.Voucher) phần</div>
            </div>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">📜</div>
            <div>
                <div class="text-xs text-muted font-medium">Chứng nhận đã trao</div>
                <div class="text-xl font-extrabold text-emerald-600">@detailedRecords.Count(r => r.RewardType == RewardTypeDto.Certificate) chứng nhận</div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm mb-6 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-xs font-bold uppercase text-muted mb-1">Loại phần thưởng</label>
                <select @onchange="OnCategoryChanged" class="w-full px-3 py-2 border rounded-xl focus:ring-2 focus:ring-indigo-500 text-sm">
                    <option value="" selected="@(string.IsNullOrEmpty(selectedCategoryId))">-- Tất cả loại phần thưởng --</option>
                    @foreach (var cat in availableCategories)
                    {
                        <option value="@cat.Id" selected="@(cat.Id == selectedCategoryId)">@cat.Name</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase text-muted mb-1">Từ ngày</label>
                <input type="date" value="@fromDateString" @onchange="OnFromDateChanged" class="w-full px-3 py-2 border rounded-xl focus:ring-2 focus:ring-indigo-500 text-sm" />
            </div>

            <div>
                <label class="block text-xs font-bold uppercase text-muted mb-1">Đến ngày</label>
                <input type="date" value="@toDateString" @onchange="OnToDateChanged" class="w-full px-3 py-2 border rounded-xl focus:ring-2 focus:ring-indigo-500 text-sm" />
            </div>

            <div>
                <label class="block text-xs font-bold uppercase text-muted mb-1">Sắp xếp theo thời gian</label>
                <select @onchange="OnSortOrderChanged" class="w-full px-3 py-2 border rounded-xl focus:ring-2 focus:ring-indigo-500 text-sm">
                    <option value="desc" selected="@(sortOrder == "desc")">Từ mới nhất đến cũ nhất</option>
                    <option value="asc" selected="@(sortOrder == "asc")">Từ cũ nhất đến mới nhất</option>
                </select>
            </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
            <input type="text" value="@searchKeyword" @oninput="OnSearchInput" placeholder="Tìm kiếm theo Email, Tên sinh viên hoặc tên Quà..." class="flex-grow px-3 py-2 border rounded-xl focus:ring-2 focus:ring-indigo-500 text-sm" />
            <button @onclick="LoadData" class="px-5 py-2 bg-indigo-600 text-white font-semibold text-sm rounded-xl hover:bg-indigo-700">Lọc dữ liệu</button>
            <button @onclick="ResetFilters" class="px-4 py-2 border text-gray-600 font-semibold text-sm rounded-xl hover:bg-gray-50">Đặt lại</button>
        </div>
    </div>

    <!-- Data Table -->
    <DataTable TItem="UserRewardRecordDto" Items="detailedRecords" TotalCount="detailedRecords.Count" 
               Page="page" PageSize="pageSize" PageChanged="OnPageChanged" ShowSearch="false" IsLoading="isLoading">
        <TableHeader>
            <th class="px-6 py-3 text-left text-xs font-bold text-muted uppercase tracking-wider font-mono">Email / Sinh viên</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-muted uppercase tracking-wider font-mono">Loại phần thưởng</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-muted uppercase tracking-wider font-mono">Chi tiết</th>
            <th class="px-6 py-3 text-right text-xs font-bold text-muted uppercase tracking-wider font-mono">Giá trị / Số lượng</th>
            <th class="px-6 py-3 text-left text-xs font-bold text-muted uppercase tracking-wider font-mono">Sự kiện</th>
            <th class="px-6 py-3 text-right text-xs font-bold text-muted uppercase tracking-wider font-mono">Thời gian nhận</th>
        </TableHeader>
        <RowTemplate Context="row">
            <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-bold text-charcoal">@row.StudentEmail</div>
                <div class="text-xs text-muted">@row.StudentName</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
                @switch (row.RewardType)
                {
                    case RewardTypeDto.TrainingPoint:
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700">
                            ⭐ Điểm rèn luyện
                        </span>
                        break;
                    case RewardTypeDto.PhysicalGift:
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700">
                            🎁 Quà vật lý
                        </span>
                        break;
                    case RewardTypeDto.Voucher:
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                            🏷️ Voucher / Code
                        </span>
                        break;
                    case RewardTypeDto.Certificate:
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700">
                            📜 Chứng nhận
                        </span>
                        break;
                    default:
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">
                            🪙 @row.RewardCategoryName
                        </span>
                        break;
                }
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
                <div class="font-bold text-charcoal">@row.DetailName</div>
                <div class="text-xs text-muted">@row.RewardCategoryName</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-extrabold text-indigo-600">
                @(row.RewardType == RewardTypeDto.TrainingPoint ? "+" + row.Amount + " điểm" : row.Amount.ToString("N0") + " phần")
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 font-medium">
                @row.EventTitle
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-xs text-muted font-mono">
                @row.GrantedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </td>
        </RowTemplate>
    </DataTable>
</div>

@code {
    private List<StudentRewardSummaryDto> statsList = new();
    private List<UserRewardRecordDto> detailedRecords = new();
    private List<RewardCategoryDto> availableCategories = new();
    private bool isLoading = true;
    private int page = 1;
    private int pageSize = 10;

    private string? selectedCategoryId;
    private DateTime? fromDate;
    private DateTime? toDate;
    private string fromDateString = "";
    private string toDateString = "";
    private string sortOrder = "desc";
    private string searchKeyword = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            availableCategories = await RewardService.GetCategoriesByTenantAsync("all", activeOnly: false);
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Lỗi tải danh mục phần thưởng: " + ex.Message);
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            statsList = await RewardService.GetTenantUserRewardStatsAsync(
                "all",
                rewardCategoryId: selectedCategoryId,
                rewardType: null,
                fromDate: fromDate,
                toDate: toDate,
                sortOrder: sortOrder,
                searchKeyword: searchKeyword
            );

            detailedRecords = statsList
                .SelectMany(s => s.Records)
                .ToList();

            if (sortOrder.Equals("asc", StringComparison.OrdinalIgnoreCase))
            {
                detailedRecords = detailedRecords.OrderBy(r => r.GrantedAt).ToList();
            }
            else
            {
                detailedRecords = detailedRecords.OrderByDescending(r => r.GrantedAt).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Không thể tải báo cáo thống kê: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnPageChanged(int newPage) => page = newPage;

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        selectedCategoryId = e.Value?.ToString();
        if (string.IsNullOrEmpty(selectedCategoryId)) selectedCategoryId = null;
        page = 1;
        await LoadData();
    }

    private async Task OnFromDateChanged(ChangeEventArgs e)
    {
        fromDateString = e.Value?.ToString() ?? "";
        if (DateTime.TryParse(fromDateString, out var dt)) fromDate = dt;
        else fromDate = null;
        page = 1;
        await LoadData();
    }

    private async Task OnToDateChanged(ChangeEventArgs e)
    {
        toDateString = e.Value?.ToString() ?? "";
        if (DateTime.TryParse(toDateString, out var dt)) toDate = dt;
        else toDate = null;
        page = 1;
        await LoadData();
    }

    private async Task OnSortOrderChanged(ChangeEventArgs e)
    {
        sortOrder = e.Value?.ToString() ?? "desc";
        page = 1;
        await LoadData();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchKeyword = e.Value?.ToString() ?? "";
        page = 1;
        await LoadData();
    }

    private async Task ResetFilters()
    {
        selectedCategoryId = null;
        fromDate = null;
        toDate = null;
        fromDateString = "";
        toDateString = "";
        sortOrder = "desc";
        searchKeyword = "";
        page = 1;
        await LoadData();
    }

    private async Task ExportToCsv()
    {
        if (!detailedRecords.Any())
        {
            ToastService.ShowWarning("Không có dữ liệu để xuất file!");
            return;
        }

        var sb = new StringBuilder();
        sb.AppendLine("STT,Email,Ten Sinh Vien,Loai Phan Thuong,Chi Tiet,Gia Tri,Su Kien,Thoi Gian Nhan");

        int index = 1;
        foreach (var row in detailedRecords)
        {
            sb.AppendLine($"{index},{EscapeCsv(row.StudentEmail)},{EscapeCsv(row.StudentName)},{EscapeCsv(row.RewardCategoryName)},{EscapeCsv(row.DetailName)},{row.Amount},{EscapeCsv(row.EventTitle)},{row.GrantedAt.ToLocalTime():yyyy-MM-dd HH:mm:ss}");
            index++;
        }

        var preamble = Encoding.UTF8.GetPreamble();
        var contentBytes = Encoding.UTF8.GetBytes(sb.ToString());
        var bytes = new byte[preamble.Length + contentBytes.Length];
        Buffer.BlockCopy(preamble, 0, bytes, 0, preamble.Length);
        Buffer.BlockCopy(contentBytes, 0, bytes, preamble.Length, contentBytes.Length);

        var fileName = "BaoCao_ChiTiet_PhanThuong_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ".csv";

        await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", fileName, Convert.ToBase64String(bytes), "text/csv");
        ToastService.ShowSuccess("Đã xuất file báo cáo chi tiết thành công!");
    }

    private string EscapeCsv(string field)
    {
        if (string.IsNullOrEmpty(field)) return "";
        if (field.Contains(",") || field.Contains("\"") || field.Contains("\n"))
        {
            return "\"" + field.Replace("\"", "\"\"") + "\"";
        }
        return field;
    }
}
