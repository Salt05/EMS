@using EMS.Shared.DTOs.Rewards
@using EMS.BlazorWASM.Services
@inject IRewardServiceClient RewardService
@inject ToastService ToastService

<div class="bg-white border border-border rounded-xl p-6 shadow-sm mb-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-border">
        <div>
            <h3 class="text-lg font-bold text-charcoal flex items-center gap-2">
                <svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V6a2 2 0 10-2 2h2zm0 13C10.832 21 9 20.1 9 19c0-1.1 1.832-2 3-2s3 .9 3 2c0 1.1-1.832 2-3 2z" />
                </svg>
                Phần thưởng & Quà tặng sự kiện
            </h3>
            <p class="text-xs text-muted mt-0.5">Cấu hình các phần thưởng (Điểm rèn luyện, Quà vật lý, Voucher...) người tham gia nhận được khi điểm danh thành công</p>
        </div>
        <button type="button" @onclick="OpenAddModal" class="px-3.5 py-2 text-xs font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors flex items-center gap-1.5 shadow-sm">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            + Thêm phần thưởng
        </button>
    </div>

    <!-- Reward Items List -->
    @if (isLoading)
    {
        <div class="py-8 text-center text-xs text-muted">
            Đang tải thông tin phần thưởng...
        </div>
    }
    else if (!rewards.Any())
    {
        <div class="py-8 text-center bg-canvas rounded-xl border border-dashed border-border">
            <svg class="w-8 h-8 text-amber-400 mx-auto mb-2 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <p class="text-xs font-medium text-muted">Sự kiện này chưa được thiết lập phần thưởng nào.</p>
            <button type="button" @onclick="OpenAddModal" class="mt-2 text-xs font-semibold text-amber-600 hover:underline">
                + Thêm phần thưởng đầu tiên
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            @foreach (var rw in rewards)
            {
                var cat = categories.FirstOrDefault(c => c.Id == rw.RewardCategoryId);
                <div class="p-3.5 bg-canvas/40 border border-border rounded-xl flex items-center justify-between hover:border-amber-200 transition-colors">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center font-bold text-sm shrink-0">
                            🎁
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold text-charcoal">@rw.DetailName</span>
                                <span class="px-2 py-0.5 text-[10px] font-semibold text-amber-800 bg-amber-100 rounded-full border border-amber-200">
                                    @(cat?.Name ?? "Phần thưởng")
                                </span>
                            </div>
                            <div class="text-[11px] text-muted mt-0.5 flex items-center gap-2">
                                <span>Số lượng / Giá trị: <strong>@rw.ValueOrQuantity</strong></span>
                                @if (!string.IsNullOrEmpty(rw.Description))
                                {
                                    <span>• @rw.Description</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-1">
                        <button type="button" @onclick="() => OpenEditModal(rw)" class="px-2.5 py-1 text-xs font-semibold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 border border-indigo-100 rounded-md transition-colors">
                            Sửa
                        </button>
                        <button type="button" @onclick="() => DeleteReward(rw)" class="p-1 text-muted hover:text-rose-600 transition-colors" title="Xóa phần thưởng">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal Add/Edit Reward -->
@if (showModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-charcoal/60 backdrop-blur-sm animate-fadeIn">
        <div class="bg-white border border-border rounded-2xl shadow-2xl max-w-lg w-full p-6 relative">
            <button type="button" @onclick="CloseModal" class="absolute top-4 right-4 text-muted hover:text-charcoal p-1 rounded-lg">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <div class="mb-5 pb-3 border-b border-border">
                <h3 class="text-base font-bold text-charcoal">
                    @(editingReward == null ? "Thêm phần thưởng sự kiện" : "Chỉnh sửa phần thưởng")
                </h3>
                <p class="text-xs text-muted mt-0.5">Chọn loại phần thưởng và điền thông tin chi tiết dành cho người tham gia</p>
            </div>

            @if (!string.IsNullOrEmpty(modalError))
            {
                <div class="mb-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl">
                    @modalError
                </div>
            }

            <div class="space-y-4">
                <!-- Select Reward Category -->
                <div>
                    <label class="block text-xs font-semibold text-charcoal mb-1">
                        Loại phần thưởng <span class="text-rose-500">*</span>
                    </label>
                    <select class="w-full px-3 py-2 text-xs border border-border rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none bg-white" @bind="selectedCategoryId">
                        <option value="">-- Chọn danh mục loại phần thưởng --</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name (@GetRewardTypeName(c.Type))</option>
                        }
                    </select>
                </div>

                <!-- Detail Name -->
                <div>
                    <label class="block text-xs font-semibold text-charcoal mb-1">
                        Tên chi tiết phần thưởng <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" placeholder="Ví dụ: +5 Điểm rèn luyện, Áo thun sự kiện, Voucher 50k..." 
                           class="w-full px-3 py-2 text-xs border border-border rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none bg-canvas/30" 
                           @bind="detailName" />
                </div>

                <!-- Value or Quantity -->
                <div>
                    <label class="block text-xs font-semibold text-charcoal mb-1">
                        Giá trị / Số lượng (Điểm hoặc Số lượng quà)
                    </label>
                    <input type="number" min="1" 
                           class="w-full px-3 py-2 text-xs border border-border rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none bg-white" 
                           @bind="valueOrQuantity" />
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-xs font-semibold text-charcoal mb-1">Ghi chú (Tùy chọn)</label>
                    <textarea rows="2" placeholder="Ghi chú điều kiện hoặc hướng dẫn nhận quà..." 
                              class="w-full px-3 py-2 text-xs border border-border rounded-xl focus:ring-2 focus:ring-amber-500 focus:outline-none bg-canvas/30" 
                              @bind="description"></textarea>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 border-t border-border pt-4 mt-5">
                <button type="button" @onclick="CloseModal" class="px-4 py-2 text-xs font-semibold text-charcoal bg-white border border-border hover:bg-canvas rounded-xl transition-colors">
                    Hủy bỏ
                </button>
                <button type="button" @onclick="SaveReward" class="px-5 py-2 text-xs font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded-xl transition-colors shadow-sm">
                    Lưu phần thưởng
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string EventId { get; set; } = string.Empty;
    [Parameter] public string TenantId { get; set; } = "default";

    private List<EventRewardDto> rewards = new();
    private List<RewardCategoryDto> categories = new();
    private bool isLoading = true;

    private bool showModal = false;
    private EventRewardDto? editingReward = null;

    private string selectedCategoryId = string.Empty;
    private string detailName = string.Empty;
    private double valueOrQuantity = 1;
    private string? description;
    private string? modalError;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(EventId)) return;
        isLoading = true;

        categories = await RewardService.GetCategoriesByTenantAsync(TenantId, activeOnly: true);
        rewards = await RewardService.GetRewardsByEventAsync(EventId, TenantId);

        isLoading = false;
    }

    private void OpenAddModal()
    {
        editingReward = null;
        selectedCategoryId = categories.FirstOrDefault()?.Id ?? string.Empty;
        detailName = string.Empty;
        valueOrQuantity = 1;
        description = null;
        modalError = null;
        showModal = true;
    }

    private void OpenEditModal(EventRewardDto rw)
    {
        editingReward = rw;
        selectedCategoryId = rw.RewardCategoryId;
        detailName = rw.DetailName;
        valueOrQuantity = rw.ValueOrQuantity;
        description = rw.Description ?? string.Empty;
        modalError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingReward = null;
    }

    private async Task SaveReward()
    {
        if (string.IsNullOrWhiteSpace(selectedCategoryId))
        {
            modalError = "Vui lòng chọn loại phần thưởng.";
            return;
        }

        if (string.IsNullOrWhiteSpace(detailName))
        {
            modalError = "Vui lòng nhập tên chi tiết phần thưởng.";
            return;
        }

        if (valueOrQuantity <= 0)
        {
            modalError = "Giá trị / Số lượng phải lớn hơn 0.";
            return;
        }

        if (editingReward == null)
        {
            rewards.Add(new EventRewardDto
            {
                Id = Guid.NewGuid().ToString(),
                EventId = EventId,
                TenantId = TenantId,
                RewardCategoryId = selectedCategoryId,
                DetailName = detailName.Trim(),
                ValueOrQuantity = valueOrQuantity,
                Description = description?.Trim() ?? string.Empty
            });
        }
        else
        {
            editingReward.RewardCategoryId = selectedCategoryId;
            editingReward.DetailName = detailName.Trim();
            editingReward.ValueOrQuantity = valueOrQuantity;
            editingReward.Description = description?.Trim() ?? string.Empty;
        }

        var success = await RewardService.SaveEventRewardsAsync(EventId, TenantId, rewards);
        if (success)
        {
            ToastService.ShowSuccess("Lưu phần thưởng thành công!");
            showModal = false;
            editingReward = null;
        }
        else
        {
            modalError = "Không thể lưu phần thưởng. Vui lòng thử lại.";
        }
    }

    private async Task DeleteReward(EventRewardDto rw)
    {
        rewards.Remove(rw);
        var success = await RewardService.SaveEventRewardsAsync(EventId, TenantId, rewards);
        if (success)
        {
            ToastService.ShowInfo("Đã xóa phần thưởng.");
        }
    }

    private string GetRewardTypeName(RewardTypeDto type)
    {
        return type switch
        {
            RewardTypeDto.TrainingPoint => "Điểm rèn luyện",
            RewardTypeDto.PhysicalGift => "Quà vật lý",
            RewardTypeDto.Voucher => "Voucher",
            RewardTypeDto.Certificate => "Giấy chứng nhận",
            RewardTypeDto.InternalCoin => "Internal Coin",
            _ => "Phần thưởng"
        };
    }
}
