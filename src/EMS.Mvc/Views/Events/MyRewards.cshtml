@model List<EMS.Core.Entities.UserRewardRecord>
@using EMS.Core.Entities.Enums
@{
    ViewData["Title"] = "Phần thưởng của tôi";
    var selectedType = ViewBag.SelectedType as RewardType?;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
}

<div class="container my-5">
    <div class="row mb-4">
        <div class="col-md-8 mx-auto text-center">
            <span class="eyebrow-tag">Kho quà & Tích lũy</span>
            <h1 class="heading-gradient heading-gradient-md mb-2">Phần thưởng của tôi</h1>
            <p class="subtitle-text">
                Theo dõi điểm rèn luyện, quà tặng vật lý và chứng nhận bạn đã tích lũy từ các sự kiện đã tham gia.
            </p>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="glass-card p-4 mb-4">
        <form id="rewardFilterForm" method="get" asp-action="MyRewards" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-muted-custom">Loại phần thưởng</label>
                <select id="filterType" name="type" class="form-select glass-input">
                    <option value="">-- Tất cả loại --</option>
                    <option value="@((int)RewardType.TrainingPoint)" selected="@(selectedType == RewardType.TrainingPoint)">⭐ Điểm rèn luyện</option>
                    <option value="@((int)RewardType.PhysicalGift)" selected="@(selectedType == RewardType.PhysicalGift)">🎁 Quà tặng vật lý</option>
                    <option value="@((int)RewardType.Voucher)" selected="@(selectedType == RewardType.Voucher)">🏷️ Voucher / Giftcode</option>
                    <option value="@((int)RewardType.Certificate)" selected="@(selectedType == RewardType.Certificate)">📜 Giấy chứng nhận</option>
                    <option value="@((int)RewardType.InternalCoin)" selected="@(selectedType == RewardType.InternalCoin)">🪙 Coin nội bộ</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted-custom">Từ ngày</label>
                <input id="fromDate" type="date" name="fromDate" value="@fromDate" class="form-control glass-input" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted-custom">Đến ngày</label>
                <input id="toDate" type="date" name="toDate" value="@toDate" class="form-control glass-input" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn-cta w-100 justify-content-center py-2">
                    <i class="ri-filter-3-line me-1"></i> Lọc
                </button>
                <button type="button" id="resetFilterBtn" class="btn-glass py-2" title="Xóa bộ lọc">
                    <i class="ri-refresh-line"></i>
                </button>
            </div>
        </form>
    </div>

    <!-- Dynamic Content Container (Partial View rendered via AJAX) -->
    <div id="rewardsContent" style="transition: opacity 0.2s ease-in-out;">
        @await Html.PartialAsync("_MyRewardsTablePartial", Model)
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('rewardFilterForm');
            const rewardsContent = document.getElementById('rewardsContent');
            const resetBtn = document.getElementById('resetFilterBtn');
            const typeInput = document.getElementById('filterType');
            const fromInput = document.getElementById('fromDate');
            const toInput = document.getElementById('toDate');

            function applyFilter() {
                const params = new URLSearchParams({
                    type: typeInput.value || '',
                    fromDate: fromInput.value || '',
                    toDate: toInput.value || ''
                });

                const newUrl = `${window.location.pathname}?${params.toString()}`;
                window.history.pushState(null, '', newUrl);

                rewardsContent.style.opacity = '0.5';

                fetch(newUrl, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (!response.ok) throw new Error('Network response error');
                    return response.text();
                })
                .then(html => {
                    rewardsContent.innerHTML = html;
                })
                .catch(err => {
                    console.error('Filter failed:', err);
                })
                .finally(() => {
                    rewardsContent.style.opacity = '1';
                });
            }

            typeInput.addEventListener('change', applyFilter);
            fromInput.addEventListener('change', applyFilter);
            toInput.addEventListener('change', applyFilter);

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                applyFilter();
            });

            resetBtn.addEventListener('click', function () {
                typeInput.value = '';
                fromInput.value = '';
                toInput.value = '';
                applyFilter();
            });
        });
    </script>
}
