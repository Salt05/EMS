@model EMS.Core.Entities.Event
@inject EMS.Core.Interfaces.Services.IEventRewardService EventRewardService
@{
    ViewData["Title"] = Model.Title;
    string? userSession = Context.Request.Cookies["user_session"];
    string? displayName = null;
    if (!string.IsNullOrEmpty(userSession))
    {
        displayName = userSession.Split('|')[0];
    }
}



<div class="container my-5">
    <!-- Back Navigation -->
    <div class="mb-4">
        <a asp-action="Index" class="btn-glass">
            <i class="ri-arrow-left-s-line"></i> Quay lại danh sách
        </a>
    </div>

    <!-- Error Message Alert -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-glass alert-glass-danger mb-4" role="alert">
            <i class="ri-error-warning-line" style="font-size:1.15rem;"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="row g-4">
        <!-- Left: Image & Content -->
        <div class="col-lg-8">
            <div class="glass-card overflow-hidden mb-4">
                <!-- Double-bezel image -->
                <div class="detail-image-wrap">
                    <div class="detail-image-shell">
                        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1200&auto=format&fit=crop&q=60" : Model.ImageUrl)"
                             alt="@Model.Title"
                             onerror="this.onerror=null;this.src='https://placehold.co/1200x400/6366f1/ffffff?text=EMS+Event';">
                    </div>
                </div>

                <div class="p-4 p-md-5">
                    <event-status-badge event="@Model" style="position:static; display:inline-block; margin-bottom:1rem;"></event-status-badge>
                    <h1 class="heading-gradient heading-gradient-md mb-4">@Model.Title</h1>

                    <span class="eyebrow-tag" style="margin-bottom:0.75rem;">Giới thiệu sự kiện</span>
                    <div style="color:var(--text-secondary); line-height:1.8; white-space:pre-line;">
                        @Model.Description
                    </div>
                </div>
            </div>

            @{
                var mainTenantId = Model.TenantId ?? Context.Items["TenantId"]?.ToString() ?? "default";
                var mainRewards = await EventRewardService.GetRewardsByEventAsync(Model.Id, mainTenantId);
            }
            <style>
                .reward-section-card {
                    background: linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(30, 27, 75, 0.8));
                    border: 1px solid rgba(245, 158, 11, 0.25);
                    backdrop-filter: blur(20px);
                    -webkit-backdrop-filter: blur(20px);
                    border-radius: 1.5rem;
                    box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.15);
                    position: relative;
                    overflow: hidden;
                }
                .reward-section-card::before {
                    content: '';
                    position: absolute;
                    top: -80px;
                    right: -80px;
                    width: 220px;
                    height: 220px;
                    background: radial-gradient(circle, rgba(245, 158, 11, 0.18) 0%, rgba(236, 72, 153, 0.05) 60%, transparent 80%);
                    pointer-events: none;
                }
                .reward-header-icon {
                    width: 52px;
                    height: 52px;
                    border-radius: 1rem;
                    background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(236, 72, 153, 0.25));
                    border: 1px solid rgba(245, 158, 11, 0.4);
                    color: #fbbf24;
                    font-size: 1.55rem;
                    box-shadow: 0 8px 20px -4px rgba(245, 158, 11, 0.3);
                    flex-shrink: 0;
                }
                .reward-title-text {
                    background: linear-gradient(135deg, #ffffff 40%, #fbbf24 100%);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                }
                .reward-item-card {
                    background: rgba(255, 255, 255, 0.04);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    border-radius: 1.25rem;
                    padding: 1.25rem 1.35rem;
                    backdrop-filter: blur(10px);
                    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
                }
                .reward-item-card:hover {
                    transform: translateY(-4px);
                    background: rgba(255, 255, 255, 0.08);
                    border-color: rgba(245, 158, 11, 0.45);
                    box-shadow: 0 12px 30px -8px rgba(245, 158, 11, 0.25), inset 0 1px 1px rgba(255, 255, 255, 0.2);
                }
                .reward-item-icon {
                    width: 48px;
                    height: 48px;
                    border-radius: 0.875rem;
                    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(168, 85, 247, 0.25));
                    border: 1px solid rgba(168, 85, 247, 0.35);
                    color: #c084fc;
                    font-size: 1.35rem;
                    box-shadow: 0 4px 12px rgba(168, 85, 247, 0.15);
                    flex-shrink: 0;
                    transition: all 0.35s ease;
                }
                .reward-item-card:hover .reward-item-icon {
                    background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(236, 72, 153, 0.25));
                    border-color: rgba(245, 158, 11, 0.5);
                    color: #fbbf24;
                }
                .reward-value-pill {
                    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(5, 150, 105, 0.25));
                    color: #34d399;
                    border: 1px solid rgba(52, 211, 153, 0.35);
                    font-weight: 700;
                    font-size: 0.82rem;
                    padding: 0.35rem 0.85rem;
                    border-radius: 9999px;
                    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.15);
                }
                /* Light theme compatibility */
                [data-bs-theme="light"] .reward-section-card,
                body.light-mode .reward-section-card {
                    background: linear-gradient(135deg, #ffffff, #f8fafc);
                    border-color: rgba(245, 158, 11, 0.3);
                    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.08);
                }
                [data-bs-theme="light"] .reward-title-text,
                body.light-mode .reward-title-text {
                    background: linear-gradient(135deg, #0f172a 40%, #d97706 100%);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                }
                [data-bs-theme="light"] .reward-item-card,
                body.light-mode .reward-item-card {
                    background: #ffffff;
                    border-color: rgba(0, 0, 0, 0.08);
                    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
                }
                [data-bs-theme="light"] .reward-item-card:hover,
                body.light-mode .reward-item-card:hover {
                    background: #ffffff;
                    border-color: rgba(245, 158, 11, 0.5);
                    box-shadow: 0 10px 25px rgba(245, 158, 11, 0.18);
                }
            </style>

            <div class="reward-section-card p-4 p-md-5 mb-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 pb-3 border-bottom border-light border-opacity-10">
                    <div class="d-flex align-items-center gap-3">
                        <div class="reward-header-icon d-flex align-items-center justify-content-center">
                            <i class="ri-vip-crown-2-fill"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h4 class="fw-bold mb-0 reward-title-text">Phần thưởng khi tham gia sự kiện</h4>
                            </div>
                            <p class="text-secondary small mb-0 mt-1" style="font-size:0.88rem;">Tham gia &amp; điểm danh sự kiện thành công để tích lũy các phần thưởng hấp dẫn sau:</p>
                        </div>
                    </div>
                </div>

                @if (mainRewards.Any())
                {
                    <div class="row g-3">
                        @foreach (var rw in mainRewards)
                        {
                            <div class="col-md-6">
                                <div class="reward-item-card d-flex align-items-start gap-3">
                                    <div class="reward-item-icon d-flex align-items-center justify-content-center">
                                        <i class="ri-gift-2-fill"></i>
                                    </div>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                            <span class="fw-bold text-truncate" style="font-size:1.05rem; color:var(--bs-heading-color, #f8fafc);">@rw.DetailName</span>
                                            <span class="badge reward-value-pill shrink-0">
                                                <i class="ri-sparkles-fill me-1" style="color:#fbbf24;"></i>SL / Giá trị: @rw.ValueOrQuantity
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(rw.Description))
                                        {
                                            <p class="text-secondary small mb-0 mt-1 line-clamp-2" style="font-size:0.85rem; line-height:1.5;">@rw.Description</p>
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-0 mt-1" style="font-size:0.8rem; font-style:italic;">Quà tặng trực tiếp khi tham gia thành công</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 rounded-4 text-center text-secondary small" style="background: rgba(255, 255, 255, 0.02); border: 1px dashed rgba(255, 255, 255, 0.12);">
                        <i class="ri-gift-line me-1 text-muted" style="font-size:1.3rem;"></i> Sự kiện này chưa thiết lập phần thưởng hoặc quà tặng kèm theo.
                    </div>
                }
            </div>

            <!-- Agenda Timeline View -->
            <partial name="_AgendaTimeline" model="Model" />
        </div>

        <!-- Right: Detail Metadata & CTA -->
        <div class="col-lg-4">
            <div class="glass-card-strong p-4 position-sticky" style="top:100px;">
                <h4 class="fw-bold mb-4 pb-2" style="border-bottom:1px solid var(--border-subtle);">Thông tin chi tiết</h4>

                <!-- Time -->
                <div class="detail-meta-row">
                    <div class="detail-meta-icon icon-primary">
                        <i class="ri-time-line"></i>
                    </div>
                    <div>
                        <div class="form-glass-label" style="margin-bottom:0.25rem;">Thời gian</div>
                        <div style="color:var(--text-secondary); font-size:0.88rem;">
                            <strong>Bắt đầu:</strong><br/> @Model.StartTime.ToString("dd/MM/yyyy HH:mm")<br/>
                            <strong>Kết thúc:</strong><br/> @Model.EndTime.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                </div>

                <!-- Location -->
                <div class="detail-meta-row">
                    <div class="detail-meta-icon icon-success">
                        <i class="ri-map-pin-2-line"></i>
                    </div>
                    <div>
                        <div class="form-glass-label" style="margin-bottom:0.25rem;">Địa điểm</div>
                        <div style="color:var(--text-secondary); font-size:0.88rem;">@Model.Location</div>
                    </div>
                </div>

                <!-- Capacity -->
                <div class="detail-meta-row">
                    <div class="detail-meta-icon icon-warning">
                        <i class="ri-group-line"></i>
                    </div>
                    <div>
                        <div class="form-glass-label" style="margin-bottom:0.25rem;">Sức chứa tối đa</div>
                        <div style="color:var(--text-secondary); font-size:0.88rem;">@Model.Capacity người tham gia</div>
                    </div>
                </div>

                <!-- Fee -->
                <div class="detail-meta-row" style="margin-bottom:1.5rem;">
                    <div class="detail-meta-icon icon-info">
                        <i class="ri-ticket-line"></i>
                    </div>
                    <div>
                        <div class="form-glass-label" style="margin-bottom:0.25rem;">Lệ phí</div>
                        <price-format price="@Model.Price" is-free="@Model.IsFree" style="display: block; font-weight:700; font-size:0.88rem;"></price-format>
                    </div>
                </div>

                @{
                    var detailTenantId = Model.TenantId ?? Context.Items["TenantId"]?.ToString() ?? "default";
                    var detailRewards = await EventRewardService.GetRewardsByEventAsync(Model.Id, detailTenantId);
                }
                <div class="detail-meta-row" style="margin-bottom:1.5rem;">
                    <div class="detail-meta-icon icon-primary" style="background: rgba(16, 185, 129, 0.1); color: var(--success, #10b981);">
                        <i class="ri-gift-line"></i>
                    </div>
                    <div>
                        <div class="form-glass-label" style="margin-bottom:0.25rem;">Phần thưởng khi tham gia</div>
                        <div class="d-flex flex-column gap-1 mt-1">
                            @if (detailRewards.Any())
                            {
                                @foreach (var rw in detailRewards)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small text-start">
                                        <i class="ri-checkbox-circle-line me-1"></i>@rw.DetailName
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 small text-start">
                                    <i class="ri-information-line me-1"></i>Chưa thiết lập phần thưởng
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <a asp-action="DownloadIcs" asp-route-id="@Model.Id" class="btn-glass w-100 justify-content-center">
                        <i class="ri-calendar-event-line me-1"></i> Tải file lịch (.ics)
                    </a>
                </div>

                <div style="border-top:1px solid var(--border-subtle); padding-top:1.25rem;">
                    @if (displayName != null)
                    {
                        @if (ViewBag.RegistrationStatus == EMS.Core.Entities.Enums.RegistrationStatus.Approved)
                        {
                            <div class="alert-glass alert-glass-success mb-3" style="justify-content:center;">
                                <i class="ri-checkbox-circle-line"></i>
                                <span style="font-size:0.85rem;">Bạn đã đăng ký tham gia sự kiện này.</span>
                            </div>

                            @if (ViewBag.RegistrationCheckedIn == true)
                            {
                                <div class="alert-glass alert-glass-success mb-3" style="justify-content:center; background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.3);">
                                    <i class="ri-checkbox-circle-fill" style="color:var(--success);"></i>
                                    <span style="font-size:0.85rem; color:var(--success); font-weight:600;">Bạn đã check-in thành công.</span>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success py-2.5 text-center mb-3 small rounded-3" role="alert">
                                    <i class="bi bi-check-circle-fill me-1"></i> Bạn đã đăng ký tham gia sự kiện này.
                                </div>

                                <!-- ═══════ CHECK-IN SECTION ═══════ -->
                                <div class="checkin-section mb-4">
                                    <div class="checkin-tabs-wrapper mb-4">
                                        <button type="button" class="checkin-tab pill-tab-btn active" data-tab="tab-code">
                                            <i class="ri-key-2-line"></i><span>Nhập mã</span>
                                        </button>
                                        <button type="button" class="checkin-tab pill-tab-btn" data-tab="tab-qr">
                                            <i class="ri-qr-code-line"></i><span>Mã QR</span>
                                        </button>
                                    </div>

                                    <!-- Tab 1: Enter Code -->
                                    <div class="checkin-tab-content active" id="tab-code">
                                        <form asp-action="CheckInWithCode" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="eventId" value="@Model.Id" />
                                            <div class="mb-4">
                                                <input type="text" name="code" class="form-control text-center font-mono text-uppercase fw-bold glass-input-code py-3" 
                                                       placeholder="NHẬP MÃ ĐIỂM DANH" maxlength="10" required autocomplete="off" />
                                            </div>
                                            <button type="submit" class="btn-cta w-100 justify-content-center py-2.5 rounded-pill shadow-sm">
                                                <span>Xác nhận điểm danh</span>
                                                <span class="btn-icon-circle"><i class="ri-checkbox-circle-line"></i></span>
                                            </button>
                                        </form>
                                    </div>

                                    <!-- Tab 2: Show QR Code Inline (No Modal, Zero Backdrop) -->
                                    <div class="checkin-tab-content text-center" id="tab-qr" style="display:none;" data-event-id="@Model.Id">
                                        <div class="p-3.5 rounded-4 glass-card border shadow-sm">
                                            <div class="text-xs fw-bold text-uppercase banner-text-sub mb-2.5">
                                                <i class="ri-qr-code-line text-warning me-1"></i> Mã QR điểm danh của bạn
                                            </div>
                                            
                                            <div id="inlineQrContainer" class="d-flex align-items-center justify-content-center my-2 p-2 bg-white rounded-3 mx-auto shadow-sm" style="width: 176px; height: 176px;">
                                                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tạo QR...</span></div>
                                            </div>
                                            
                                            <div id="inlineQrText" class="font-mono fw-bold fs-5 text-indigo mt-2 tracking-wider"></div>
                                            <div id="inlineQrExpiryText" class="banner-text-sub small mt-1"></div>
                                            <div id="inlineQrErrorAlert" class="alert alert-danger p-2 small mt-2 mb-0" style="display:none;"></div>
                                            
                                            <button type="button" class="btn-cta-outline btn-cta-sm w-100 justify-content-center mt-3" id="btnRefreshQr">
                                                <i class="ri-refresh-line me-1"></i> Làm mới mã QR
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <form asp-action="Cancel" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="eventId" value="@Model.Id" />
                                    <button type="submit" class="btn-danger-outline w-100 py-2">
                                        <i class="ri-close-circle-line"></i> Hủy đăng ký vé
                                    </button>
                                </form>
                            }
                        }
                        else if (ViewBag.RegistrationStatus == EMS.Core.Entities.Enums.RegistrationStatus.PendingPayment)
                        {
                            <div class="alert-glass alert-glass-warning mb-3" style="justify-content:center;">
                                <i class="ri-wallet-2-line"></i>
                                <span style="font-size:0.85rem;">Vé đang chờ thanh toán (VNPAY).</span>
                            </div>
                            <a href="@Url.Action("Pay", "Payment", new { registrationId = ViewBag.RegistrationId })" class="btn-cta w-100 justify-content-center py-3 mb-2" style="background: linear-gradient(135deg, #005baa, #007bff); border: none;">
                                <span>Thanh toán ngay</span>
                                <span class="btn-icon-circle"><i class="ri-bank-card-line"></i></span>
                            </a>
                            <form asp-action="Cancel" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@Model.Id" />
                                <button type="submit" class="btn-danger-outline w-100 py-2">
                                    <i class="ri-close-circle-line"></i> Hủy đăng ký
                                </button>
                            </form>
                        }
                        else if (ViewBag.RegistrationStatus == EMS.Core.Entities.Enums.RegistrationStatus.Pending)
                        {
                            <div class="alert-glass alert-glass-warning mb-3" style="justify-content:center;">
                                <i class="ri-hourglass-line"></i>
                                <span style="font-size:0.85rem;">Đăng ký đang chờ phê duyệt.</span>
                            </div>
                            <form asp-action="Cancel" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@Model.Id" />
                                <button type="submit" class="btn-danger-outline w-100 py-2">
                                    <i class="ri-close-circle-line"></i> Hủy yêu cầu đăng ký
                                </button>
                            </form>
                        }
                        else if (ViewBag.RegistrationStatus == EMS.Core.Entities.Enums.RegistrationStatus.Rejected)
                        {
                            <div class="alert-glass alert-glass-danger mb-3" style="justify-content:center;">
                                <i class="ri-forbid-line"></i>
                                <span style="font-size:0.85rem;">Đăng ký của bạn đã bị từ chối.</span>
                            </div>
                            <form asp-action="Register" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@Model.Id" />
                                <button type="submit" class="btn-cta w-100 justify-content-center py-3">
                                    <span>Đăng ký lại</span>
                                    <span class="btn-icon-circle"><i class="ri-refresh-line"></i></span>
                                </button>
                            </form>
                        }
                        else
                        {
                            if (Model.Scope == EMS.Core.Entities.Enums.EventScope.TenantViewOnly)
                            {
                                <div class="alert-glass alert-glass-info mb-3" style="justify-content:center;">
                                    <i class="ri-information-line"></i>
                                    <span style="font-size:0.85rem;">Sự kiện này chỉ dành cho xem thông tin (Không mở đăng ký).</span>
                                </div>
                            }
                            else
                            {
                                <form asp-action="Register" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="eventId" value="@Model.Id" />
                                    <button type="submit" class="btn-cta w-100 justify-content-center py-3">
                                        @if (Model.IsFree)
                                        {
                                            <span>Đăng ký vé miễn phí</span>
                                            <span class="btn-icon-circle"><i class="ri-flashlight-line"></i></span>
                                        }
                                        else
                                        {
                                            <span>Mua vé ngay (<price-format price="@Model.Price" style="color: inherit;"></price-format>)</span>
                                            <span class="btn-icon-circle"><i class="ri-shopping-cart-2-line"></i></span>
                                        }
                                    </button>
                                </form>
                            }
                        }
                    }
                    else
                    {
                        <div class="alert-glass alert-glass-warning mb-3" style="justify-content:center;">
                            <i class="ri-error-warning-line"></i>
                            <span style="font-size:0.85rem;">Bạn cần đăng nhập để đăng ký.</span>
                        </div>
                        <a asp-controller="Auth" asp-action="Login" class="btn-cta w-100 justify-content-center py-2">
                            <span>Đăng nhập ngay</span>
                            <span class="btn-icon-circle"><i class="ri-login-box-line"></i></span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .checkin-tab-content { display: none; }
    .checkin-tab-content.active { display: block; }
    .checkin-tab.active { background-color: var(--bs-primary, #4f46e5); color: #fff !important; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Tab switching
        var tabs = document.querySelectorAll('.checkin-tab');
        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                tabs.forEach(function (t) { t.classList.remove('active'); });
                tab.classList.add('active');
                document.querySelectorAll('.checkin-tab-content').forEach(function (c) {
                    c.classList.remove('active');
                    c.style.display = 'none';
                });
                var target = document.getElementById(tab.getAttribute('data-tab'));
                if (target) {
                    target.classList.add('active');
                    target.style.display = 'block';
                }
            });
        });

        // Inline QR Code generation handler
        var isQrLoaded = false;
        function generateInlineQrCode() {
            var tabQrEl = document.getElementById('tab-qr');
            if (!tabQrEl) return;

            var eventId = tabQrEl.getAttribute('data-event-id');
            var container = document.getElementById('inlineQrContainer');
            var textEl = document.getElementById('inlineQrText');
            var expiryEl = document.getElementById('inlineQrExpiryText');
            var errorEl = document.getElementById('inlineQrErrorAlert');

            if (!container) return;

            container.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tạo...</span></div>';
            if (textEl) textEl.textContent = '';
            if (expiryEl) expiryEl.textContent = '';
            if (errorEl) errorEl.style.display = 'none';

            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            console.log("Generating Inline QR Code for event:", eventId);
            fetch('/Events/GenerateQrCode', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'eventId=' + encodeURIComponent(eventId) + '&__RequestVerificationToken=' + encodeURIComponent(token)
            })
            .then(function (r) {
                if (!r.ok) return r.text().then(function (text) { throw new Error("HTTP " + r.status + ": " + text); });
                return r.json();
            })
            .then(function (data) {
                if (data.success) {
                    container.innerHTML = '';
                    var img = document.createElement('img');
                    img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=' + encodeURIComponent(data.code);
                    img.alt = 'QR Code';
                    img.className = 'img-fluid mx-auto';
                    img.style.width = '160px';
                    img.style.height = '160px';

                    img.onerror = function () {
                        this.src = 'https://chart.googleapis.com/chart?cht=qr&chs=160x160&chl=' + encodeURIComponent(data.code);
                        this.onerror = function () {
                            this.src = 'https://quickchart.io/qr?text=' + encodeURIComponent(data.code) + '&size=160';
                        };
                    };

                    container.appendChild(img);
                    if (textEl) textEl.textContent = data.code;
                    if (expiryEl && data.expiresAt) {
                        expiryEl.innerHTML = '<i class="ri-time-line me-1 text-warning"></i>Hết hạn: ' + data.expiresAt;
                    }
                    isQrLoaded = true;
                } else {
                    container.innerHTML = '<i class="ri-error-warning-line text-warning fs-1"></i>';
                    if (errorEl) {
                        errorEl.textContent = data.error || 'Không thể tạo mã QR';
                        errorEl.style.display = 'block';
                    }
                }
            })
            .catch(function (err) {
                container.innerHTML = '<i class="ri-wifi-off-line text-danger fs-1"></i>';
                if (errorEl) {
                    errorEl.textContent = 'Lỗi kết nối: ' + err.message;
                    errorEl.style.display = 'block';
                }
            });
        }

        // Auto load QR on tab switch or button click
        var qrTabTrigger = document.querySelector('[data-tab="tab-qr"]');
        if (qrTabTrigger) {
            qrTabTrigger.addEventListener('click', function () {
                if (!isQrLoaded) {
                    generateInlineQrCode();
                }
            });
        }

        var btnRefreshQr = document.getElementById('btnRefreshQr');
        if (btnRefreshQr) {
            btnRefreshQr.addEventListener('click', function () {
                generateInlineQrCode();
            });
        }
    });
</script>

