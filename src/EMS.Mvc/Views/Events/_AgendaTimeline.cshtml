@model EMS.Core.Entities.Event
@inject EMS.Core.Interfaces.Services.IAgendaService AgendaService

@{
    var tenantId = Model.TenantId ?? Context.Items["TenantId"]?.ToString() ?? "default";
    var agendaItems = await AgendaService.GetAgendaByEventAsync(Model.Id, tenantId);
}

<div class="glass-card p-4 p-md-5 mb-4" id="agenda-timeline-container">
    <span class="eyebrow-tag" style="margin-bottom:0.75rem;">Lịch trình</span>
    <h3 class="section-heading mb-4"><i class="ri-history-line text-primary-custom me-2"></i>Chi tiết chương trình</h3>

    @if (agendaItems == null || !agendaItems.Any())
    {
        <div id="agenda-empty" class="text-center py-4">
            <i class="ri-calendar-close-line text-muted" style="font-size: 2rem;"></i>
            <p class="text-muted-custom small mt-2 mb-0">Chưa có lịch trình chi tiết cho sự kiện này.</p>
        </div>
    }
    else
    {
        <div id="agenda-timeline" class="timeline-container">
            @foreach (var item in agendaItems)
            {
                var startStr = item.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
                var endStr = item.EndTime.ToLocalTime().ToString("HH:mm");
                var timeRange = $"{startStr} - {endStr}";

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="timeline-time">
                            <i class="ri-time-line"></i> @timeRange
                        </div>
                        <div class="timeline-title fw-semibold">@item.Title</div>
                    </div>
                </div>
            }
        </div>
    }
</div>
